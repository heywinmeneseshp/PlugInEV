{
  "expo": {
    "name": "Plugin",
    "slug": "PlugInEV",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0F1A",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Necesitamos tu ubicación para encontrar estaciones de carga cercanas."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#0B0F1A"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyC9o_LQGNFuIsC1Ml7AJsCXsa9slwCSogA"
        }
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.anonymous.PlugInEV"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Necesitamos tu ubicación para encontrar estaciones de carga cercanas."
        }
      ],
      "expo-font",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "c4cc30be-f874-47ff-9e16-08aef5f7646a"
      }
    }
  }
}
